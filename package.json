{
  "name": "chatme-server",
  "type": "module",
  "version": "1.0.0",
  "description": "Chat ME server for education purpose, maybe release in future",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "run": "node build/index.js",
    "build:watch": "tsc --watch",
    "run:watch": "nodemon build/index.js --watch build",
    "start": "npm-run-all --parallel build:watch run:watch"
  },
  "keywords": [
    "chat",
    "application",
    "server"
  ],
  "author": "Pasan Semage",
  "license": "ISC",
  "dependencies": {
    "http": "^0.0.1-security",
    "websocket": "^1.0.34"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/websocket": "^1.0.10",
    "nodemon": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.3"
  }
}